{
  "name": "creamy-browser",
  "productName": "Creamy Browser",
  "version": "1.0.0",
  "description": "Creamy Browser for Windows",
  "main": "main.js",
  "author": "Cream ai Hub",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.cream.creamybrowser",
    "productName": "Creamy Browser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "adblock.js",
      "translate.js",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Cream-ai-Hub-Windows-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Cream-ai-Hub-Windows-Portable.${ext}"
    }
  }
}
