<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 상단 둥근 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="14dp" />

    <!-- 세그먼트 토글 바: [일반 탭] vs [보안 탭] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_input_box"
        android:padding="3dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/btnSegmentNormalTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="일반 탭"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="@color/primary_black"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSegmentSecurityTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="보안 탭"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 헤더: 열린 탭 타이틀 + 새 탭 + 닫기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvTabManagerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="열린 탭"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/tvTabCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnNewTabTop"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="+ 새 탭"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_black"
            android:textColor="@color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="16dp"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/btnCloseTabManager"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- 비활성 절전 탭 안내 배너 (메모리 절약) -->
    <LinearLayout
        android:id="@+id/bannerInactiveTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="#F0FDF4"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_leaf"
            app:tint="#16A34A"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvInactiveBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2개 탭이 절전 모드로 메모리를 절약 중입니다"
            android:textSize="11sp"
            android:textColor="#15803D" />

        <TextView
            android:id="@+id/btnCloseInactiveTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="절전 탭 정리"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#16A34A"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 탭 목록 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/layoutTabsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

    <!-- 하단 새 탭 및 모두 닫기 버튼 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnCloseAllTabs"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="모두 닫기"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/text_muted"
            app:strokeColor="@color/border_gray"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnNewTabBottom"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:text="+ 새 탭 열기"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_black"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
