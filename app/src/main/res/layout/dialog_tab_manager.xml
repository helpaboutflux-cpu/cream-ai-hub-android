<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutTabManagerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="18dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 드래그 핸들 -->
    <View
        android:id="@+id/viewTabManagerHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="6dp" />

    <!-- 헤더: 뒤로가기 · 탭 타이틀 · 검색 · 더보기 -->
    <LinearLayout
        android:id="@+id/layoutTabManagerHeader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp">

        <ImageView
            android:id="@+id/btnTabManagerBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="닫기" />

        <TextView
            android:id="@+id/tvTabManagerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="탭"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:letterSpacing="-0.02"
            android:layout_marginStart="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnTabManagerSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="2dp"
            android:contentDescription="탭 검색" />

        <ImageView
            android:id="@+id/btnTabManagerMore"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="더보기" />
    </LinearLayout>

    <!-- 탭 검색 입력 -->
    <LinearLayout
        android:id="@+id/layoutTabSearchRow"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input_box"
        android:paddingHorizontal="12dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_muted"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etTabSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="탭 제목이나 주소로 검색"
            android:textSize="13sp"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/primary_black"
            android:background="@null"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <ImageView
            android:id="@+id/btnClearTabSearch"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="5dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="검색어 지우기" />
    </LinearLayout>

    <!-- 비활성 절전 탭 안내 배너 -->
    <LinearLayout
        android:id="@+id/bannerInactiveTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="#E4E4E7"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_leaf"
            app:tint="@color/primary_black"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvInactiveBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2개 탭이 절전 모드로 메모리를 절약 중입니다"
            android:textSize="11sp"
            android:textColor="@color/primary_black" />

        <TextView
            android:id="@+id/btnCloseInactiveTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="절전 탭 정리"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 탭 카드 목록 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTabList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="180dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/layoutTabsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 플로팅 알약 툴바 -->
    <LinearLayout
        android:id="@+id/layoutTabPillBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="#F4F4F5"
        android:elevation="8dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/btnTabGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:text="그룹"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:drawableStart="@drawable/ic_group"
            android:drawablePadding="6dp"
            android:drawableTint="@color/primary_black"
            android:paddingHorizontal="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvTabCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#FFFFFF"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/btnSecurityTabsToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:text="보안 탭"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:drawableStart="@drawable/ic_shield"
            android:drawablePadding="6dp"
            android:drawableTint="@color/primary_black"
            android:paddingHorizontal="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnNewTabPill"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="+"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="@color/primary_black"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="새 탭" />
    </LinearLayout>

</LinearLayout>
