<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="페이지 QR코드"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/primary_black" />

    <TextView
        android:id="@+id/tvQrPageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="현재 페이지"
        android:textColor="@color/text_muted"
        android:textSize="11.5sp" />

    <ImageView
        android:id="@+id/ivQrCode"
        android:layout_width="236dp"
        android:layout_height="236dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@color/white"
        android:contentDescription="페이지 QR코드"
        android:padding="10dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvQrUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="2"
        android:text="https://"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCloseQr"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="닫기"
            android:textColor="@color/primary_black"
            android:textSize="12sp"
            app:cornerRadius="20dp"
            app:strokeColor="@color/border_gray" />

        <Button
            android:id="@+id/btnSaveQrGallery"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="갤러리 저장"
            android:textColor="@color/primary_black"
            android:textSize="12sp"
            app:cornerRadius="20dp"
            app:strokeColor="@color/border_gray" />

        <Button
            android:id="@+id/btnShareQr"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/primary_black"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="공유"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />
    </LinearLayout>
</LinearLayout>
