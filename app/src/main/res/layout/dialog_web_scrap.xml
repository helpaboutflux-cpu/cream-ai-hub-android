<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutScrapRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingHorizontal="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvScrapTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="스크랩 메모"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/btnCloseScrap"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="닫기" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvScrapSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="화면 위에 S펜이나 손가락으로 표시하고 메모를 남기세요"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="10dp" />

    <FrameLayout
        android:id="@+id/layoutScrapCanvasBox"
        android:layout_width="match_parent"
        android:layout_height="268dp"
        android:background="@drawable/bg_result_box"
        android:clipToOutline="true">

        <com.cream.aihub.ScrapCanvasView
            android:id="@+id/scrapCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 펜 도구 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <View
            android:id="@+id/penColorBlack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp" />

        <View
            android:id="@+id/penColorWhite"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp" />

        <View
            android:id="@+id/penColorRed"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp" />

        <View
            android:id="@+id/penColorBlue"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvPenThin"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="얇게"
            android:textSize="11sp"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#F4F4F5"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/tvPenMedium"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="보통"
            android:textSize="11sp"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#F4F4F5"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/tvPenThick"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="굵게"
            android:textSize="11sp"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#F4F4F5"
            android:paddingHorizontal="10dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPenEraser"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="지우개"
            android:textSize="11sp"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#F4F4F5"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvScrapUndo"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="실행취소"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#F4F4F5"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvScrapClear"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="전체 지우기"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#F4F4F5"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etScrapMemo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:maxLines="3"
        android:hint="메모를 남겨보세요 (예: 이 부분 나중에 다시 보기)"
        android:textSize="12.5sp"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/primary_black"
        android:background="@drawable/bg_input_box"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:inputType="textMultiLine|textCapSentences" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnSaveScrapGallery"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="갤러리 저장"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/primary_black"
            app:strokeColor="@color/border_gray"
            app:cornerRadius="14dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveScrapBag"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.4"
            android:text="My Bag에 저장"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_black"
            android:textColor="@color/white"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
