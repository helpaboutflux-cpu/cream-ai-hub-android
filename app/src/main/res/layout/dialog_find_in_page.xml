<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/bg_bottom_sheet">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_search"
        app:tint="@color/text_muted"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Search Icon" />

    <EditText
        android:id="@+id/etFindQuery"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:hint="페이지 내 찾을 단어 입력..."
        android:textSize="13sp"
        android:textColor="@color/primary_black"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_input_box"
        android:paddingHorizontal="10dp"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/btnFindPrev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/primary_black"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="4dp"
        android:contentDescription="Previous" />

    <ImageView
        android:id="@+id/btnFindNext"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_forward"
        app:tint="@color/primary_black"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Next" />

    <ImageView
        android:id="@+id/btnFindClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        app:tint="@color/text_muted"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close" />

</LinearLayout>
