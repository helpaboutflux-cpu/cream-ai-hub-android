<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutTabletTabItem"
    android:layout_width="168dp"
    android:layout_height="32dp"
    android:layout_marginEnd="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="5dp"
    android:background="@drawable/bg_tablet_tab_inactive"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivTabletTabIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_globe"
        app:tint="@color/text_muted"
        android:contentDescription="탭 아이콘" />

    <TextView
        android:id="@+id/tvTabletTabTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="새 탭"
        android:textColor="@color/text_muted"
        android:textSize="11.5sp" />

    <ImageView
        android:id="@+id/btnTabletTabClose"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:padding="4dp"
        android:src="@drawable/ic_close"
        app:tint="@color/text_muted"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="탭 닫기" />
</LinearLayout>
