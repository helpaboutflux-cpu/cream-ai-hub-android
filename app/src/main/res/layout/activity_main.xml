<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 데스크탑 & 모바일 통합 상단 툴바 -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 태블릿 데스크탑 모드: 뒤로가기 -->
        <ImageView
            android:id="@+id/btnTopBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="Back" />

        <!-- 태블릿 데스크탑 모드: 앞으로가기 -->
        <ImageView
            android:id="@+id/btnTopForward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="Forward" />

        <!-- 태블릿 데스크탑 모드: 새로고침 -->
        <ImageView
            android:id="@+id/btnTopReload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_marginEnd="6dp"
            android:contentDescription="Reload" />

        <!-- 중앙 주소창 캡슐 (데스크탑 옴니박스 스타일 + 보안 현황 락 아이콘) -->
        <LinearLayout
            android:id="@+id/layoutAddressBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="10dp">

            <!-- 보안 현황 자물쇠 / 방패 아이콘 (클릭 시 보안 상세 바텀시트 오픈) -->
            <ImageView
                android:id="@+id/ivUrlIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="4dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/primary_black"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp"
                android:contentDescription="Security Info" />

            <!-- 보안 탭 표시 인디케이터 배지 -->
            <TextView
                android:id="@+id/tvTopSecurityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보안"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#4F46E5"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etBrowserUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="웹 주소 또는 검색어 입력..."
                android:textSize="13.5sp"
                android:textColor="@color/primary_black"
                android:textColorHint="@color/text_muted"
                android:background="@null"
                android:imeOptions="actionGo"
                android:inputType="textUri|textNoSuggestions"
                android:textCursorDrawable="@drawable/cursor_black"
                android:maxLines="1"
                android:selectAllOnFocus="true" />

            <!-- 주소창 지우기 버튼 -->
            <ImageView
                android:id="@+id/btnClearUrl"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_muted"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:contentDescription="Clear" />

            <!-- 모바일용 새로고침 버튼 (폰 모드일 때만 표시) -->
            <ImageView
                android:id="@+id/btnMobileReload"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="5dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/primary_black"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reload" />
        </LinearLayout>

        <!-- 브라우저 메뉴 버튼 (공유, 북마크, 보안 탭, 다운로드, 설정) -->
        <ImageView
            android:id="@+id/btnTopMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="6dp"
            android:contentDescription="Menu" />

        <!-- 태블릿 데스크탑 홈 버튼 -->
        <ImageView
            android:id="@+id/btnTopHome"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_home"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_marginStart="4dp"
            android:contentDescription="Home" />

        <!-- 사이드바 토글 버튼 (태블릿 전용) -->
        <LinearLayout
            android:id="@+id/btnToggleSidebar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="10dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sidebar"
                app:tint="@color/primary_black"
                android:contentDescription="Sidebar Icon" />

            <TextView
                android:id="@+id/tvSidebarBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사이드바"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_black"
                android:layout_marginStart="5dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 상단 프로그레스바 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/primary_black"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar" />

    <!-- 주소창 클릭 시 최근 검색어 및 검색 제안 오버레이 (Omnibox Suggestions Overlay) -->
    <LinearLayout
        android:id="@+id/layoutSearchSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="12dp"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <!-- 클립보드 붙여넣기 칩 (클립보드에 텍스트가 있을 때 노출) -->
        <LinearLayout
            android:id="@+id/chipClipboardPaste"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_result_box"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_share"
                app:tint="@color/primary_black"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvClipboardText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="복사된 링크 바로 이동"
                android:textSize="12sp"
                android:textColor="@color/primary_black"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 최근 검색어 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="최근 검색어"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/btnClearSearchHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="모두 삭제"
                android:textSize="11.5sp"
                android:textColor="@color/text_muted"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 최근 검색어 목록 컨테이너 -->
        <LinearLayout
            android:id="@+id/layoutRecentSearchesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp" />

        <!-- 최근 방문 사이트 칩 가로 스크롤 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="자주 방문한 사이트"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutRecentSitesChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </LinearLayout>

    <!-- 메인 콘텐츠 영역: 웹뷰 + 사이드바 수평 분할 컨테이너 -->
    <LinearLayout
        android:id="@+id/layoutMainContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar">

        <!-- 메인 브라우징 웹뷰 영역 -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 태블릿 & 데스크탑 전용 사이드바 (Sidebar: 340dp) -->
        <LinearLayout
            android:id="@+id/layoutSidebar"
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_light"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@color/white">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_sparkles"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvSidebarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Creamy AI 사이드바"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnTabAi"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="AI"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="@color/primary_black"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnTabBookmarks"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="북마크"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_pill_badge"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnTabMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="메뉴"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_pill_badge"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/btnCloseSidebar"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="5dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/text_muted"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <LinearLayout
                android:id="@+id/layoutTabAiContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_bottom_sheet"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="현재 열려 있는 페이지"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvSidebarPageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="페이지 감지 중..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_black"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvSidebarPageUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="https://..."
                        android:textSize="10.5sp"
                        android:textColor="@color/text_muted"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSidebarQuickSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="3줄 요약"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/primary_black"
                            android:textColor="@color/white"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="17dp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnSidebarQuickQuestions"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="핵심 질문"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/primary_black"
                            app:strokeColor="@color/border_gray"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="17dp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnSidebarQuickTranslate"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="번역"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/primary_black"
                            app:strokeColor="@color/border_gray"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="17dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ScrollView
                    android:id="@+id/scrollSidebarChat"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:background="@drawable/bg_result_box"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:id="@+id/layoutSidebarChatMessages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSidebarAiResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Creamy AI가 준비되었습니다. 상단 3줄 요약을 누르거나 아래에 페이지에 대해 질문하세요."
                            android:textSize="12.5sp"
                            android:lineSpacingExtra="3.5dp"
                            android:textColor="#18181B" />
                    </LinearLayout>
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etSidebarQuery"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="이 페이지에 대해 묻기..."
                        android:textSize="12sp"
                        android:textColor="@color/primary_black"
                        android:textColorHint="@color/text_muted"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_input_box"
                        android:imeOptions="actionSend"
                        android:inputType="text|textCapSentences"
                        android:textCursorDrawable="@drawable/cursor_black"
                        android:maxLines="1" />

                    <Button
                        android:id="@+id/btnSidebarSend"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="전송"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_black"
                        android:textColor="@color/white"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="22dp"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutTabBookmarksContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <!-- 북마크 헤더 및 폴더 탭 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="북마크 및 즐겨찾기"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_black" />

                    <Button
                        android:id="@+id/btnSidebarAddBookmark"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="+ 북마크 저장"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_black"
                        android:textColor="@color/white"
                        app:cornerRadius="16dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <!-- 사이드바 폴더 가로 스크롤 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:id="@+id/layoutSidebarBookmarkFoldersBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>

                <!-- 사이드바 북마크 목록 스크롤 -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/layoutSidebarBookmarksList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

            </LinearLayout>

            <!-- 탭 3: 메뉴 패널 (태블릿 데스크탑 모드에서 메뉴 버튼 누를 시 활성화) -->
            <ScrollView
                android:id="@+id/layoutTabMenuContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="빠른 동작"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="8dp" />

                    <!-- 4구 퀵 액션 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <Button
                            android:id="@+id/btnSidebarQuickNewTab"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="새 탭"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/primary_black"
                            android:textColor="@color/white"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnSidebarQuickReload"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="새로고침"
                            android:textSize="10.5sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/primary_black"
                            app:strokeColor="@color/border_gray"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnSidebarQuickShare"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="공유"
                            android:textSize="10.5sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/primary_black"
                            app:strokeColor="@color/border_gray"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnSidebarQuickBookmark"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="북마크"
                            android:textSize="10.5sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/primary_black"
                            app:strokeColor="@color/border_gray"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_gray"
                        android:layout_marginBottom="12dp" />

                    <!-- 메뉴 리스트 -->
                    <TextView
                        android:id="@+id/btnSidebarMenuBag"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="Bag 보관함 (링크·이미지 스크랩)"
                        android:textSize="12.5sp"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnSidebarMenuDownloads"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="다운로드 관리자"
                        android:textSize="12.5sp"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnSidebarMenuHistory"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="방문 기록"
                        android:textSize="12.5sp"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnSidebarMenuSecurity"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="보안 현황 (SSL 인증서 및 쿠키)"
                        android:textSize="12.5sp"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnSidebarMenuFind"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="페이지 내 단어 찾기"
                        android:textSize="12.5sp"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnSidebarMenuReader"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="클린 리더 모드 (광고 제거 본문 읽기)"
                        android:textSize="12.5sp"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnSidebarMenuTranslate"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="한국어로 번역하기"
                        android:textSize="12.5sp"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnSidebarMenuDesktop"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="데스크탑 PC 모드로 보기"
                        android:textSize="12.5sp"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnSidebarMenuPrint"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="인쇄 및 PDF 저장"
                        android:textSize="12.5sp"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_gray"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:id="@+id/btnSidebarMenuSettings"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:text="브라우저 설정 및 개인화"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_black"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground" />

                </LinearLayout>
            </ScrollView>

        </LinearLayout>

    </LinearLayout>

    <!-- 모바일 전용 하단 내비게이션 바 (블러 / 반투명 글래스) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_browser_bar"
        android:elevation="8dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnNavBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnNavForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <!-- 중앙 Creamy AI 알약 버튼 -->
        <LinearLayout
            android:id="@+id/btnNavCreamy"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="14dp"
            android:backgroundTint="@color/primary_black"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sparkles"
                app:tint="@color/white"
                android:contentDescription="AI" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creamy AI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <!-- 탭 목록 버튼 (열린 탭 수 표시) -->
        <FrameLayout
            android:id="@+id/btnNavTabs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tabs">

            <TextView
                android:id="@+id/tvNavTabCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tab_counter"
                android:gravity="center"
                android:text="1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary_black" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnNavHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_home"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
