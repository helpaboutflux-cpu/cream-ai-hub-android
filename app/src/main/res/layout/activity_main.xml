<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 브라우저 상단 주소 및 검색창 바 -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="12dp">

            <!-- Cream 스월 로고 / 검색 아이콘 -->
            <ImageView
                android:id="@+id/ivUrlIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_muted"
                android:layout_marginEnd="8dp"
                android:contentDescription="Search Icon" />

            <!-- URL / 검색어 입력창 -->
            <EditText
                android:id="@+id/etBrowserUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="웹 주소 또는 검색어 입력..."
                android:textSize="13sp"
                android:textColor="@color/primary_black"
                android:textColorHint="@color/text_muted"
                android:background="@null"
                android:imeOptions="actionGo"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="1"
                android:selectAllOnFocus="true" />

            <!-- 새로고침 / 로딩 중지 버튼 -->
            <ImageView
                android:id="@+id/btnReload"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="5dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/primary_black"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reload" />
        </LinearLayout>
    </LinearLayout>

    <!-- 로딩 진행바 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/primary_black"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar" />

    <!-- 웹뷰 영역 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 브라우저 하단 컨트롤 툴바 -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_browser_bar"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 뒤로 가기 -->
        <ImageView
            android:id="@+id/btnNavBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 앞으로 가기 -->
        <ImageView
            android:id="@+id/btnNavForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <!-- 중앙 Creamy AI 어시스턴트 알약 버튼 -->
        <LinearLayout
            android:id="@+id/btnNavCreamy"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="14dp"
            android:backgroundTint="@color/primary_black"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sparkles"
                app:tint="@color/white"
                android:contentDescription="AI" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creamy AI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <!-- 공유 / 링크 복사 -->
        <ImageView
            android:id="@+id/btnNavShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_share"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 홈 (Cream ai Hub 본체 복귀) -->
        <ImageView
            android:id="@+id/btnNavHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_home"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
