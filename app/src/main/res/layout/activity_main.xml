<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 데스크탑 & 모바일 통합 상단 툴바 -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 태블릿 데스크탑 모드: 뒤로가기 -->
        <ImageView
            android:id="@+id/btnTopBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="Back" />

        <!-- 태블릿 데스크탑 모드: 앞으로가기 -->
        <ImageView
            android:id="@+id/btnTopForward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="Forward" />

        <!-- 태블릿 데스크탑 모드: 새로고침 -->
        <ImageView
            android:id="@+id/btnTopReload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_marginEnd="6dp"
            android:contentDescription="Reload" />

        <!-- 중앙 주소창 캡슐 (데스크탑 옴니박스 스타일) -->
        <LinearLayout
            android:id="@+id/layoutAddressBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/ivUrlIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_muted"
                android:layout_marginEnd="8dp"
                android:contentDescription="Search Icon" />

            <EditText
                android:id="@+id/etBrowserUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="웹 주소 또는 검색어 입력..."
                android:textSize="13.5sp"
                android:textColor="@color/primary_black"
                android:textColorHint="@color/text_muted"
                android:background="@null"
                android:imeOptions="actionGo"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="1"
                android:selectAllOnFocus="true" />

            <!-- 모바일용 새로고침 버튼 (폰 모드일 때만 표시) -->
            <ImageView
                android:id="@+id/btnMobileReload"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="5dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/primary_black"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reload" />
        </LinearLayout>

        <!-- 브라우저 메뉴 버튼 (공유, 북마크, 설정) -->
        <ImageView
            android:id="@+id/btnTopMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="6dp"
            android:contentDescription="Menu" />

        <!-- 태블릿 데스크탑 홈 버튼 -->
        <ImageView
            android:id="@+id/btnTopHome"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_home"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_marginStart="4dp"
            android:contentDescription="Home" />

        <!-- 핵심 기능: 사이드바 토글 버튼 (Sidebar Toggle) -->
        <LinearLayout
            android:id="@+id/btnToggleSidebar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="10dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sidebar"
                app:tint="@color/primary_black"
                android:contentDescription="Sidebar Icon" />

            <TextView
                android:id="@+id/tvSidebarBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사이드바"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_black"
                android:layout_marginStart="5dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 상단 2dp 미니멀 프로그레스바 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/primary_black"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar" />

    <!-- 메인 콘텐츠 영역: 웹뷰 + 사이드바 수평 분할 컨테이너 -->
    <LinearLayout
        android:id="@+id/layoutMainContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar">

        <!-- 메인 브라우징 웹뷰 영역 -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 태블릿 & 데스크탑 전용 사이드바 (Sidebar: 340dp) -->
        <LinearLayout
            android:id="@+id/layoutSidebar"
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_light"
            android:visibility="gone">

            <!-- 사이드바 상단 1px 보더 라인 (좌측) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 사이드바 헤더: 타이틀 + 탭 전환 + 닫기 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@color/white">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_sparkles"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="AI Icon" />

                <TextView
                    android:id="@+id/tvSidebarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Creamy AI 사이드바"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- 탭 전환 알약: [AI 비서] / [바로가기] -->
                <TextView
                    android:id="@+id/btnTabAi"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="AI"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="@color/primary_black"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnTabBookmarks"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="북마크"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_pill_badge"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/btnCloseSidebar"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="5dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/text_muted"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close Sidebar" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- [탭 1] Creamy AI 사이드 패널 컨텐츠 -->
            <LinearLayout
                android:id="@+id/layoutTabAiContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 현재 감지된 웹페이지 요약 카드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_bottom_sheet"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄 현재 열려 있는 페이지"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvSidebarPageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="페이지 감지 중..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_black"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvSidebarPageUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="https://..."
                        android:textSize="10.5sp"
                        android:textColor="@color/text_muted"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- 빠른 AI 액션 칩 바 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSidebarQuickSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="✨ 3줄 요약"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/primary_black"
                            android:textColor="@color/white"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="17dp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnSidebarQuickQuestions"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="💡 핵심 질문"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/primary_black"
                            app:strokeColor="@color/border_gray"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="17dp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnSidebarQuickTranslate"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="🌐 번역"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/primary_black"
                            app:strokeColor="@color/border_gray"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="17dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 사이드바 AI 대화 내역 스크롤 뷰 -->
                <ScrollView
                    android:id="@+id/scrollSidebarChat"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:background="@drawable/bg_result_box"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:id="@+id/layoutSidebarChatMessages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSidebarAiResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Creamy AI가 준비되었습니다. 상단 3줄 요약을 누르거나 아래에 페이지에 대해 질문하세요."
                            android:textSize="12.5sp"
                            android:lineSpacingExtra="3.5dp"
                            android:textColor="#18181B" />
                    </LinearLayout>
                </ScrollView>

                <!-- 사이드바 질문 입력창 바 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etSidebarQuery"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="이 페이지에 대해 묻기..."
                        android:textSize="12sp"
                        android:textColor="@color/primary_black"
                        android:textColorHint="@color/text_muted"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_input_box"
                        android:imeOptions="actionSend"
                        android:inputType="text|textCapSentences"
                        android:maxLines="1" />

                    <Button
                        android:id="@+id/btnSidebarSend"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="전송"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_black"
                        android:textColor="@color/white"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="22dp"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- [탭 2] 북마크 & 바로가기 사이드 패널 컨텐츠 -->
            <LinearLayout
                android:id="@+id/layoutTabBookmarksContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ 빠른 바로가기"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black"
                    android:layout_marginBottom="10dp" />

                <!-- 바로가기 칩 그리드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnShortcutCreamHub"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="🍦 Cream ai Hub 공식 홈"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/primary_black"
                        app:strokeColor="@color/border_gray"
                        android:gravity="start|center_vertical"
                        app:cornerRadius="12dp"
                        android:layout_marginBottom="6dp" />

                    <Button
                        android:id="@+id/btnShortcutGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="🔍 Google 검색"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/primary_black"
                        app:strokeColor="@color/border_gray"
                        android:gravity="start|center_vertical"
                        app:cornerRadius="12dp"
                        android:layout_marginBottom="6dp" />

                    <Button
                        android:id="@+id/btnShortcutNaver"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="🟢 네이버 (Naver)"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/primary_black"
                        app:strokeColor="@color/border_gray"
                        android:gravity="start|center_vertical"
                        app:cornerRadius="12dp"
                        android:layout_marginBottom="6dp" />

                    <Button
                        android:id="@+id/btnShortcutGitHub"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="🐙 GitHub"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/primary_black"
                        app:strokeColor="@color/border_gray"
                        android:gravity="start|center_vertical"
                        app:cornerRadius="12dp"
                        android:layout_marginBottom="6dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_gray"
                    android:layout_marginBottom="14dp" />

                <!-- 현재 페이지 북마크 추가 -->
                <Button
                    android:id="@+id/btnAddBookmark"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="+ 현재 페이지 북마크에 추가"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary_black"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 모바일 전용 하단 내비게이션 바 (블러 / 반투명 글래스) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_browser_bar"
        android:elevation="8dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnNavBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnNavForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <!-- 중앙 Creamy AI 알약 버튼 -->
        <LinearLayout
            android:id="@+id/btnNavCreamy"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="14dp"
            android:backgroundTint="@color/primary_black"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sparkles"
                app:tint="@color/white"
                android:contentDescription="AI" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creamy AI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <!-- 탭 목록 버튼 (열린 탭 수 표시) -->
        <FrameLayout
            android:id="@+id/btnNavTabs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tabs">

            <TextView
                android:id="@+id/tvNavTabCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tab_counter"
                android:gravity="center"
                android:text="1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary_black" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnNavHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_home"
            app:tint="@color/primary_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
