<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 상단 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="브라우저 설정 &amp; 개인화"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:letterSpacing="-0.02" />

        <ImageView
            android:id="@+id/btnCloseSettingsIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 설정 1: Material You 다이내믹 컬러 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_palette"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Material You 모드"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="시스템 배경화면 다이내믹 색상을 앱 테마에 적용"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMaterialYou"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 설정 1-2: 새 탭 컬러 아이콘 표시 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_sparkles"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="새 탭 사이트 컬러 아이콘"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="구글, 네이버, 유튜브 등 공식 컬러 로고 표시"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchColorFavicons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 설정 2: 기본 검색 엔진 선택 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기본 검색 엔진"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="주소창에 검색어 입력 시 사용할 기본 포털"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="8dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutSearchEngines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnEngineGoogle"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Google"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_pill_badge"
                            android:backgroundTint="@color/primary_black"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnEngineNaver"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Naver"
                            android:textSize="11.5sp"
                            android:textColor="@color/text_muted"
                            android:background="@drawable/bg_pill_badge"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnEngineDaum"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Daum"
                            android:textSize="11.5sp"
                            android:textColor="@color/text_muted"
                            android:background="@drawable/bg_pill_badge"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnEngineBing"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Bing"
                            android:textSize="11.5sp"
                            android:textColor="@color/text_muted"
                            android:background="@drawable/bg_pill_badge"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnEngineDuck"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="DuckDuckGo"
                            android:textSize="11.5sp"
                            android:textColor="@color/text_muted"
                            android:background="@drawable/bg_pill_badge"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 설정 3: 광고 및 트래커 차단 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="광고 및 트래커 방어"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="불필요한 광고 스크립트 및 추적기 차단"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAdBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 설정 4: 텍스트 크기 조절 (Text Zoom) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="웹페이지 글자 크기"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvZoomDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100% (기본)"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnZoom80"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="85%"
                        android:textSize="11sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/text_muted"
                        app:strokeColor="@color/border_gray"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnZoom100"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="100%"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_black"
                        android:textColor="@color/white"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnZoom120"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="115%"
                        android:textSize="11sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/text_muted"
                        app:strokeColor="@color/border_gray"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnZoom140"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="130%"
                        android:textSize="11sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/text_muted"
                        app:strokeColor="@color/border_gray"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 설정 5: AI 엔진 설정 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI 엔진 (DeepSeek API Key)"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="키가 없어도 내장 스마트 Creamy AI가 기본 자동 처리합니다."
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:hint="sk-..."
                    android:textSize="12.5sp"
                    android:textColor="@color/primary_black"
                    android:textColorHint="@color/text_muted"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/bg_input_box"
                    android:inputType="textPassword" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 확인 버튼 -->
    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="설정 저장 완료"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary_black"
        android:textColor="@color/white"
        app:cornerRadius="12dp" />

</LinearLayout>
