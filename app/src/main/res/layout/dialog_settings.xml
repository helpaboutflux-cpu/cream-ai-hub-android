<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI 엔진 설정"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/primary_black"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DeepSeek API 키를 등록하시면 클라우드 AI 모델이 직접 답변합니다. 키가 없어도 내장 스마트 엔진이 모든 질문과 요약을 자동으로 처리합니다."
        android:textSize="11.5sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DeepSeek API Key"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/primary_black"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="sk-..."
        android:textSize="12.5sp"
        android:textColor="@color/primary_black"
        android:textColorHint="@color/text_muted"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_input_box"
        android:inputType="textPassword"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="취소"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/text_muted"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="저장하기"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_black"
            android:textColor="@color/white"
            app:cornerRadius="6dp" />
    </LinearLayout>

</LinearLayout>
