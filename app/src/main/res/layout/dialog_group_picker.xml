<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_group"
            app:tint="@color/primary_black"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="탭 그룹 설정"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:letterSpacing="-0.02" />

        <ImageView
            android:id="@+id/btnCloseGroupPicker"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="새 그룹 이름"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/primary_black"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etGroupName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="예: 업무, 쇼핑, 뉴스, 리서치..."
        android:textSize="13sp"
        android:textColor="@color/primary_black"
        android:textColorHint="@color/text_muted"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_input_box"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="그룹 색상 선택"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/primary_black"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/layoutColorPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <View
            android:id="@+id/colorBlue"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_tab_counter"
            android:backgroundTint="#3B82F6"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/colorPurple"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_tab_counter"
            android:backgroundTint="#8B5CF6"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/colorGreen"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_tab_counter"
            android:backgroundTint="#10B981"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/colorOrange"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_tab_counter"
            android:backgroundTint="#F59E0B"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/colorPink"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_tab_counter"
            android:backgroundTint="#EC4899"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/colorGray"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_tab_counter"
            android:backgroundTint="#71717A"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnRemoveFromGroup"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="그룹 해제"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/text_muted"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnApplyGroup"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="그룹 적용"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_black"
            android:textColor="@color/white"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
