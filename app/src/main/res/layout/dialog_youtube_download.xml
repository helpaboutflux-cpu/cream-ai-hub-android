<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_audio"
            app:tint="@color/primary_black"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="유튜브 미디어 저장"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black" />

        <ImageView
            android:id="@+id/btnCloseYoutubeDownload"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvYoutubeVideoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="동영상"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnYoutubeSaveVideo"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="동영상 저장 (MP4)"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary_black"
        android:textColor="@color/white"
        app:cornerRadius="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnYoutubeSaveAudio"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="음원 추출 (M4A)"
        android:textSize="13sp"
        android:textStyle="bold"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="@color/primary_black"
        app:strokeColor="@color/border_gray"
        app:cornerRadius="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvYoutubeDownloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="저장 가능한 스트림을 확인하는 중입니다."
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:lineSpacingExtra="3dp" />

</LinearLayout>
