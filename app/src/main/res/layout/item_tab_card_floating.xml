<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTabRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="9dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_result_box"
    android:clickable="true"
    android:focusable="true">

    <!-- 웹페이지 화면 썸네일 미리보기 -->
    <FrameLayout
        android:id="@+id/layoutTabThumbBox"
        android:layout_width="84dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_result_box"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivTabThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="탭 미리보기" />

        <ImageView
            android:id="@+id/ivTabThumbPlaceholder"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_planet_logo"
            app:tint="@color/text_muted"
            android:contentDescription="시작 페이지" />
    </FrameLayout>

    <!-- 파비콘 · 제목 · 주소 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivTabFavicon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tabs"
                app:tint="@color/primary_black"
                android:layout_marginEnd="7dp"
                android:contentDescription="탭 아이콘" />

            <TextView
                android:id="@+id/tvTabTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="탭 제목"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:textColor="@color/primary_black"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvActiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="@color/primary_black"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="5dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvInactiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="절전"
                android:textSize="9.5sp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#E4E4E7"
                android:textColor="@color/primary_black"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGroupTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="그룹"
                android:textSize="9.5sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#3B82F6"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSecurityTabBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보안"
                android:textSize="9.5sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#4F46E5"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTabUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://..."
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:maxLines="1"
            android:ellipsize="middle"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- 닫기 버튼 -->
    <ImageView
        android:id="@+id/btnTabClose"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        app:tint="@color/text_muted"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="#F4F4F5"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="2dp"
        android:contentDescription="탭 닫기" />

</LinearLayout>
