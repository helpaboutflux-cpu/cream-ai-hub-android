<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_widget_pill"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Signature swirl logo with dark mode tint -->
    <ImageView
        android:id="@+id/widget_btn_logo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_stat_cream"
        android:tint="@color/widget_icon_tint"
        android:contentDescription="Cream ai" />

    <!-- Center prompt text with dark mode color -->
    <TextView
        android:id="@+id/widget_btn_ask"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Creamy에게 물어보세요"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Search icon with dark mode tint -->
    <ImageView
        android:id="@+id/widget_btn_search"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="2dp"
        android:src="@drawable/ic_search"
        android:tint="@color/widget_icon_tint"
        android:contentDescription="Search" />

    <!-- Mic icon with dark mode tint -->
    <ImageView
        android:id="@+id/widget_btn_mic"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="8dp"
        android:padding="2dp"
        android:src="@drawable/ic_mic"
        android:tint="@color/widget_icon_tint"
        android:contentDescription="Voice" />

</LinearLayout>
