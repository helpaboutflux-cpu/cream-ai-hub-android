<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_result_box"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivTabFavicon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_tabs"
        app:tint="@color/primary_black"
        android:layout_marginEnd="12dp"
        android:contentDescription="Tab Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 뱃지 및 제목 행 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTabTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="탭 제목"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/primary_black"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 현재 탭 뱃지 -->
            <TextView
                android:id="@+id/tvActiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="@color/primary_black"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

            <!-- 비활성 절전 탭 뱃지 -->
            <TextView
                android:id="@+id/tvInactiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="절전 중"
                android:textSize="10sp"
                android:textColor="#15803D"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#DCFCE7"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <!-- 그룹 태그 뱃지 -->
            <TextView
                android:id="@+id/tvGroupTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="그룹"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#3B82F6"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <!-- 보안 탭 뱃지 -->
            <TextView
                android:id="@+id/tvSecurityTabBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보안"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#4F46E5"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTabUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="https://..."
            android:textSize="11.5sp"
            android:textColor="@color/text_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 그룹 지정 버튼 -->
    <ImageView
        android:id="@+id/btnTabGroupAction"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_group"
        app:tint="@color/text_muted"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="2dp"
        android:contentDescription="Tab Group" />

    <!-- 탭 닫기 버튼 -->
    <ImageView
        android:id="@+id/btnTabClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_close"
        app:tint="@color/text_muted"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close Tab" />

</LinearLayout>
