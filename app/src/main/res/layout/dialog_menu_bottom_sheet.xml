<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 상단 둥근 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="14dp" />

    <!-- 헤더: 타이틀 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="메뉴"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/primary_black"
        android:letterSpacing="-0.02"
        android:layout_marginBottom="12dp" />

    <!-- 퀵 액션 4구 그리드 바 (새 탭, 보안 탭, 새로고침, 공유) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_result_box"
        android:padding="6dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/menuQuickNewTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tabs"
                app:tint="@color/primary_black"
                android:contentDescription="New Tab" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="새 탭"
                android:textSize="10.5sp"
                android:textColor="@color/primary_black"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuQuickSecurityTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shield"
                app:tint="#4F46E5"
                android:contentDescription="Security Tab" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보안 탭"
                android:textSize="10.5sp"
                android:textColor="#4F46E5"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuQuickReload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/primary_black"
                android:contentDescription="Reload" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="새로고침"
                android:textSize="10.5sp"
                android:textColor="@color/primary_black"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuQuickShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_share"
                app:tint="@color/primary_black"
                android:contentDescription="Share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="공유"
                android:textSize="10.5sp"
                android:textColor="@color/primary_black"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 메뉴 리스트 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="340dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 항목 1: Bag 보관함 열기 -->
            <LinearLayout
                android:id="@+id/menuItemBag"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_bag"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My Bag"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBagMenuCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="링크·이미지 스크랩"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 2: 현재 페이지를 Bag에 담기 -->
            <LinearLayout
                android:id="@+id/menuItemAddToBag"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="현재 페이지를 My Bag에 담기"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ 스크랩 저장"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 3: 북마크 & 즐겨찾기 폴더 -->
            <LinearLayout
                android:id="@+id/menuItemBookmarksList"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_folder"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="북마크 &amp; 즐겨찾기 폴더"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="폴더별 분류"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 4: 다운로드 관리자 -->
            <LinearLayout
                android:id="@+id/menuItemDownloads"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="다운로드"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="저장된 파일"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 5: 클린 리더 모드 -->
            <LinearLayout
                android:id="@+id/menuItemReaderMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_book_reader"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="클린 리더 모드"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="광고 없는 본문"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 6: 페이지 한국어 번역 -->
            <LinearLayout
                android:id="@+id/menuItemTranslate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_translate"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="페이지 한국어 번역"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google 번역"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 7: 데스크탑 사이트 (PC 버전) -->
            <LinearLayout
                android:id="@+id/menuItemDesktop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_desktop"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="데스크탑 사이트 (PC 모드)"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDesktopModeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="모바일 웹"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 8: 페이지 내 단어 검색 -->
            <LinearLayout
                android:id="@+id/menuItemFindInPage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="페이지 내 단어 찾기"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="본문 검색"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 9: 인쇄 및 PDF 저장 -->
            <LinearLayout
                android:id="@+id/menuItemPrint"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_print"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="인쇄 / PDF 저장"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="문서화"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 10: 최근 방문 기록 -->
            <LinearLayout
                android:id="@+id/menuItemHistory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="방문 기록"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="최근 방문"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_gray" />

            <!-- 항목 11: 설정 & 개인화 -->
            <LinearLayout
                android:id="@+id/menuItemSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_palette"
                    app:tint="@color/primary_black"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="브라우저 설정 &amp; 개인화"
                    android:textSize="13.5sp"
                    android:textColor="@color/primary_black"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Material You · 검색엔진"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
