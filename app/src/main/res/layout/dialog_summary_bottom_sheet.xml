<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutAiSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="18dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 상단 드래그 핸들 -->
    <View
        android:id="@+id/viewSheetHandle"
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ai_handle" />

    <!-- 상단 좌우 액션: 메뉴 / 닫기 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="38dp">

        <ImageView
            android:id="@+id/btnSheetMenu"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="start|center_vertical"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="메뉴" />

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="end|center_vertical"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="닫기" />
    </FrameLayout>

    <!-- 브라우저 행성 로고 -->
    <ImageView
        android:id="@+id/ivSheetLogo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:src="@drawable/ic_planet_logo"
        android:contentDescription="브라우저 로고" />

    <!-- 볼드 타이틀 -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="함께 탐색해 볼까요?"
        android:textSize="19sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:textColor="#111111" />

    <!-- 현재 페이지 안내 -->
    <TextView
        android:id="@+id/tvSharedUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="현재 페이지를 확인하는 중..."
        android:textSize="11sp"
        android:textColor="#71717A" />

    <!-- 3대 카드 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickSummary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:paddingHorizontal="4dp"
            android:gravity="center"
            android:text="요약"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:backgroundTint="#F7F7F8"
            app:cornerRadius="18dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E4E4E7"
            app:icon="@drawable/ic_ai_summary"
            app:iconSize="20dp"
            app:iconGravity="textTop"
            app:iconPadding="6dp"
            app:iconTint="#111111" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickQuestions"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:paddingHorizontal="4dp"
            android:gravity="center"
            android:text="핵심 질문"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:backgroundTint="#F7F7F8"
            app:cornerRadius="18dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E4E4E7"
            app:icon="@drawable/ic_ai_question"
            app:iconSize="20dp"
            app:iconGravity="textTop"
            app:iconPadding="6dp"
            app:iconTint="#111111" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickPageInfo"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:paddingHorizontal="4dp"
            android:gravity="center"
            android:text="페이지 정보"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:backgroundTint="#F7F7F8"
            app:cornerRadius="18dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E4E4E7"
            app:icon="@drawable/ic_ai_page_info"
            app:iconSize="20dp"
            app:iconGravity="textTop"
            app:iconPadding="6dp"
            app:iconTint="#111111" />
    </LinearLayout>

    <!-- 결과 표시 영역 (버튼을 눌렀을 때만 나타남) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSheetResult"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginBottom="12dp"
        android:fillViewport="true"
        android:visibility="gone"
        android:background="@drawable/bg_result_box"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/layoutChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSummaryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="요약, 핵심 질문, 페이지 정보 중 하나를 눌러 보세요."
                android:textSize="12.5sp"
                android:lineSpacingExtra="3dp"
                android:textColor="#18181B" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/sheetProgressBar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- 캡슐형 질문 입력창 -->
    <LinearLayout
        android:id="@+id/layoutSheetInput"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="6dp"
        android:background="@drawable/bg_input_box">

        <EditText
            android:id="@+id/etSheetQuery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="무엇이든 물어보세요"
            android:textSize="13.5sp"
            android:textColor="#111111"
            android:textColorHint="#71717A"
            android:textCursorDrawable="@drawable/cursor_black"
            android:background="@null"
            android:imeOptions="actionSend"
            android:inputType="text|textCapSentences"
            android:maxLines="1"
            android:paddingVertical="0dp" />

        <ImageView
            android:id="@+id/btnSheetMic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_mic"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="4dp"
            android:contentDescription="음성 입력" />

        <ImageView
            android:id="@+id/btnSheetSend"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_send_arrow"
            android:background="@drawable/bg_ai_send_circle"
            android:contentDescription="전송" />
    </LinearLayout>

</LinearLayout>
