<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 상단 둥근 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="#E4E4E7"
        android:layout_marginBottom="16dp" />

    <!-- 헤더: 공식 로고 + 타이틀 + 크레딧 뱃지 + 웹 채팅 이동 + 닫기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="8dp"
            android:contentDescription="Creamy Logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creamy"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="@color/primary_black"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvEngineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연결 확인 중..."
                android:textSize="10.5sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 실시간 크레딧 뱃지 (알약형) -->
        <TextView
            android:id="@+id/tvCreditBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Credits --"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginEnd="6dp" />

        <!-- 웹에서 열기 버튼 (알약형) -->
        <TextView
            android:id="@+id/btnOpenWebChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="웹 ↗"
            android:textSize="11sp"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_muted"
            android:padding="2dp"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- 공유된 이미지 카드 (부드러운 18dp 곡선) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSharedImage"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivSharedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Shared Image" />
    </androidx.cardview.widget.CardView>

    <!-- 대상 배너 -->
    <TextView
        android:id="@+id/tvSharedUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="분석 대상 준비 중..."
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="12dp" />

    <!-- 퀵 액션 알약형 버튼 바 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickSummary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="3줄 요약"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary_black"
                android:textColor="@color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnQuickQuestions"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="핵심 질문"
                android:textSize="11.5sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/primary_black"
                app:strokeColor="@color/border_gray"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnQuickImageOcr"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="글자 추출 (OCR)"
                android:textSize="11.5sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/primary_black"
                app:strokeColor="@color/border_gray"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnQuickTranslate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="번역"
                android:textSize="11.5sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/primary_black"
                app:strokeColor="@color/border_gray"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp"
                android:layout_marginEnd="6dp" />

            <!-- 이전 채팅 기록 불러오기 버튼 -->
            <Button
                android:id="@+id/btnLoadHistory"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="기록 불러오기"
                android:textSize="11.5sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/text_muted"
                app:strokeColor="@color/border_gray"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 대화 / 메시지 스크롤 영역 (둥근 18dp 박스) -->
    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:fillViewport="true"
        android:background="@drawable/bg_result_box"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSummaryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creamy가 준비되었습니다. 상단 버튼을 누르거나 아래에 질문하세요."
                android:textSize="12.5sp"
                android:lineSpacingExtra="3dp"
                android:textColor="#18181B"
                android:padding="6dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 로딩 인디케이터 -->
    <ProgressBar
        android:id="@+id/sheetProgressBar"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:indeterminateTint="@color/primary_black"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- 하단 메시지 캡슐형 입력창 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etSheetQuery"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Creamy에게 질문하기..."
            android:textSize="12.5sp"
            android:textColor="@color/primary_black"
            android:textColorHint="@color/text_muted"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_input_box"
            android:imeOptions="actionSend"
            android:inputType="text|textCapSentences"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnSheetSend"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="전송"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_black"
            android:textColor="@color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="22dp"
            android:paddingHorizontal="18dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
