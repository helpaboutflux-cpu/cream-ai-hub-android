<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D1D5DB"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍦 Cream ai 요약 도우미"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E1B4B" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="닫기" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSharedUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="공유된 링크..."
        android:textSize="12sp"
        android:textColor="#6B7280"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="14dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickSummary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📑 3줄 요약"
                android:textSize="12sp"
                android:backgroundTint="@color/purple_500"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnQuickQuestions"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="❓ 핵심 질문 3가지"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/purple_500"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnQuickTranslate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🌐 한글 번역"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/purple_500" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/sheetProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_margin="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="280dp">

        <TextView
            android:id="@+id/tvSummaryResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="상단의 [3줄 요약] 버튼을 누르면 AI가 공유된 링크의 핵심을 분석합니다."
            android:textSize="13.5sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#374151"
            android:background="#F3F0FF"
            android:padding="14dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <EditText
            android:id="@+id/etSheetQuery"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="이 링크에 대해 물어보세요..."
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_input_box" />

        <Button
            android:id="@+id/btnSheetSend"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="전송"
            android:textSize="12sp"
            android:backgroundTint="@color/purple_500"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
