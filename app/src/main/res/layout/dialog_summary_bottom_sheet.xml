<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 상단 드래그 핸들 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#E4E4E7"
        android:layout_marginBottom="14dp" />

    <!-- 헤더: 공식 로고 + 타이틀 + 설정 버튼 + 닫기 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="8dp"
            android:contentDescription="Cream ai Logo" />

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cream ai"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:letterSpacing="-0.02" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 설정 버튼 (API 키 설정) -->
        <TextView
            android:id="@+id/btnSheetSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_muted"
            android:padding="2dp"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- 공유된 이미지 카드 (이미지 공유 시 표시) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSharedImage"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        android:visibility="gone"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/ivSharedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Shared Image" />
    </androidx.cardview.widget.CardView>

    <!-- 공유된 대상 요약 배너 -->
    <TextView
        android:id="@+id/tvSharedUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="분석 대상 준비 중..."
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="10dp" />

    <!-- 퀵 액션 버튼 바 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickSummary"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="3줄 요약"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary_black"
                android:textColor="@color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="6dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnQuickQuestions"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="핵심 질문"
                android:textSize="11.5sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/primary_black"
                app:strokeColor="@color/border_gray"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="6dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnQuickImageOcr"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="글자 추출 (OCR)"
                android:textSize="11.5sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/primary_black"
                app:strokeColor="@color/border_gray"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="6dp"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnQuickTranslate"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="번역"
                android:textSize="11.5sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/primary_black"
                app:strokeColor="@color/border_gray"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 대화 / 메시지 스크롤 영역 (채팅 기록 누적) -->
    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:fillViewport="true"
        android:background="@drawable/bg_result_box"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/layoutChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 초기 환영 메시지 -->
            <TextView
                android:id="@+id/tvSummaryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cream ai가 준비되었습니다. 상단 퀵 버튼을 누르거나 아래에 자유롭게 질문하세요."
                android:textSize="12.5sp"
                android:lineSpacingExtra="3dp"
                android:textColor="#18181B"
                android:padding="6dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 로딩 인디케이터 -->
    <ProgressBar
        android:id="@+id/sheetProgressBar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:indeterminateTint="@color/primary_black"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- 하단 메시지 입력창 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etSheetQuery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="질문을 입력하세요..."
            android:textSize="12.5sp"
            android:textColor="@color/primary_black"
            android:textColorHint="@color/text_muted"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_input_box"
            android:imeOptions="actionSend"
            android:inputType="text|textCapSentences"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnSheetSend"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="전송"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_black"
            android:textColor="@color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
