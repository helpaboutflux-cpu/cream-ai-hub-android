<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D1D5DB"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍦 Cream ai 어시스턴트"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E1B4B" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="닫기" />
    </LinearLayout>

    <!-- 공유된 이미지 미리보기 (이미지 공유 시 표시) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSharedImage"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivSharedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="공유된 이미지" />
    </androidx.cardview.widget.CardView>

    <!-- 공유된 링크/텍스트 미리보기 (텍스트 공유 시 표시) -->
    <TextView
        android:id="@+id/tvSharedUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="공유된 내용..."
        android:textSize="12sp"
        android:textColor="#6B7280"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="12dp" />

    <!-- 퀵 액션 버튼 바 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickSummary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📑 3줄 요약"
                android:textSize="12sp"
                android:backgroundTint="@color/purple_500"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnQuickQuestions"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="❓ 핵심 질문"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/purple_500"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnQuickImageOcr"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📝 글자 추출(OCR)"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/purple_500"
                android:visibility="gone"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnQuickTranslate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🌐 한글 번역"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/purple_500" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/sheetProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_margin="14dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="250dp">

        <TextView
            android:id="@+id/tvSummaryResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="내용을 분석하고 있습니다..."
            android:textSize="13.5sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#374151"
            android:background="#F3F0FF"
            android:padding="14dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/etSheetQuery"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="이 사진이나 링크에 대해 물어보세요..."
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_input_box" />

        <Button
            android:id="@+id/btnSheetSend"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="전송"
            android:textSize="12sp"
            android:backgroundTint="@color/purple_500"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
