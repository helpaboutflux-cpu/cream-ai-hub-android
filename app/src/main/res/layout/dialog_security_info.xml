<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="16dp" />

    <!-- 보안 상태 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/ivSecurityStatusIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/primary_black"
            android:layout_marginEnd="12dp"
            android:contentDescription="Security Status" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSecurityStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연결이 안전함"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/primary_black"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvSecurityHost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://example.com"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseSecurityDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSecurityDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="이 사이트로 전송하는 정보(예: 비밀번호, 신용카드 번호)는 비공개로 유지되며 안전하게 암호화됩니다."
        android:textSize="12.5sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/secondary_dark"
        android:layout_marginBottom="16dp" />

    <!-- 상세 보안 카드 리스트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_result_box"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <!-- 인증서 정보 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/primary_black"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인증서 (SSL/TLS)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black" />

                <TextView
                    android:id="@+id/tvCertDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="유효한 보안 인증서 (256-bit 강력 암호화)"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_gray"
            android:layout_marginBottom="12dp" />

        <!-- 쿠키 및 사이트 데이터 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_leaf"
                app:tint="@color/primary_black"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="쿠키 및 사이트 데이터"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black" />

                <TextView
                    android:id="@+id/tvCookieDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재 사이트 쿠키 활성 (세션 유지 중)"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <Button
                android:id="@+id/btnClearSiteCookies"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="쿠키 삭제"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/primary_black"
                app:strokeColor="@color/border_gray"
                app:cornerRadius="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_gray"
            android:layout_marginBottom="12dp" />

        <!-- 사이트 권한 현황 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_desktop"
                app:tint="@color/primary_black"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="권한 현황"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="위치: 차단됨 · 카메라/마이크: 요청 시 확인 · 알림: 기본값"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 확인 버튼 -->
    <Button
        android:id="@+id/btnConfirmSecurity"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="확인"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary_black"
        android:textColor="@color/white"
        app:cornerRadius="12dp" />

</LinearLayout>
