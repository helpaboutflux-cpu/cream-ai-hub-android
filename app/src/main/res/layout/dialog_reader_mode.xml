<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="20dp">

    <!-- 상단 툴바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_book_reader"
            app:tint="@color/primary_black"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="클린 리더 모드"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnReaderTranslate"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="한국어 번역"
            android:textSize="11sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/primary_black"
            app:strokeColor="@color/border_gray"
            app:cornerRadius="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnReaderCopy"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="본문 복사"
            android:textSize="11sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/primary_black"
            app:strokeColor="@color/border_gray"
            app:cornerRadius="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/btnCloseReaderMode"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_gray"
        android:layout_marginBottom="16dp" />

    <!-- 본문 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="글 제목"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary_black"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvReaderSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="출처: example.com"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/tvReaderContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="본문 내용을 불러오는 중입니다..."
                android:textSize="15sp"
                android:textColor="#27272A"
                android:lineSpacingExtra="7dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
