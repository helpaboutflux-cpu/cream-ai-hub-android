<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 상단 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="14dp" />

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bag"
            app:tint="@color/primary_black"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Bag"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/tvBagCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnAddCurrentToBag"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="+ 페이지 담기"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_black"
            android:textColor="@color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="16dp"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/btnCloseBagDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="링크, 이미지, 영감을 주는 텍스트를 언제든 꺼내볼 수 있도록 My Bag에 담아두세요."
        android:textSize="11.5sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="12dp" />

    <!-- 필터 탭 바: [전체] [링크] [이미지] [텍스트] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btnBagFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="전체"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="@color/primary_black"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnBagFilterLinks"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="링크"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:background="@drawable/bg_pill_badge"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnBagFilterImages"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="이미지"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:background="@drawable/bg_pill_badge"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnBagFilterTexts"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="텍스트"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:background="@drawable/bg_pill_badge"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 아이템 목록 스크롤 뷰 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="340dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/layoutBagItemsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 하단 액션 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnClearBag"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="My Bag 비우기"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/text_muted"
            app:strokeColor="@color/border_gray"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnAddCustomImageToBag"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1.6"
            android:text="+ 이미지 URL 담기"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_black"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
