<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 상단 둥근 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/border_gray"
        android:layout_marginBottom="14dp" />

    <!-- 헤더 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="전체 페이지 캡처 완료"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/primary_black"
        android:letterSpacing="-0.02" />

    <TextView
        android:id="@+id/tvCaptureSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="웹페이지 전체 영역이 고화질 이미지로 캡처되었습니다."
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="14dp" />

    <!-- 미리보기 카드 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_result_box"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivCapturePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Screenshot Preview" />
    </FrameLayout>

    <!-- 액션 버튼들 (3단) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnSaveGallery"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="갤러리에 저장"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary_black"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnShareCapture"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="이미지 공유"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:backgroundTint="@color/border_gray"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnAddToBagCapture"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="My Bag에 담기"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary_black"
            android:backgroundTint="@color/border_gray" />
    </LinearLayout>

</LinearLayout>
